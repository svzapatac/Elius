  monto_maximo "numeric(14,2)" [not null, note: 'Factus: 12.100.000 COP']
  expiracion_segundos "int" [not null, note: 'Vigencia del QR y la llave; Factus por defecto 86.400 (24 h)']
  activa "boolean" [not null, note: 'Si está activa se cobra por llave; si no, por comprobante']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']

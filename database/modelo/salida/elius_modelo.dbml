  codigo "text" [not null, note: 'Código o localizador visible al cliente']
  tipo "text" [not null, note: 'cita, mesa, vuelo']
  estado "text" [not null, note: 'pendiente_pago, confirmada, asistio, no_asistio, cancelada']
  inicio "timestamptz" [not null, note: 'Inicio']
  fin "timestamptz" [null, note: 'Fin']
  personas "int" [not null, note: 'Número de personas']
  responsable_id "uuid" [null, note: 'Quién la está gestionando']
  urgente "boolean" [not null, note: 'Marcada como urgente']
  visto "boolean" [not null, note: 'Ya la vio el equipo']
  llegada_en "timestamptz" [null, note: 'Hora real de llegada']
  salida_en "timestamptz" [null, note: 'Hora real de salida']

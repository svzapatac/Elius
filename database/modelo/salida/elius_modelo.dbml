// Elius · modelo entidad-relación
// Generado desde modelo/modelo.py

Table platform.planes [note: 'Planes de suscripción y sus límites (referencia)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  codigo "text" [unique, not null, note: 'free, starter, pro, enterprise']
  nombre "text" [not null, note: 'Nombre comercial']
  precio_mensual "numeric(12,2)" [not null, note: 'Precio mensual']
  moneda "char(3)" [not null, note: 'Moneda ISO 4217']
  max_usuarios "int" [not null, note: 'Usuarios permitidos por tenant']
  max_conversaciones_mes "int" [not null, note: 'Conversaciones de Eli por mes']
  max_tokens_mes "bigint" [not null, note: 'Tokens de LLM por mes']
  activo "boolean" [not null, note: 'Disponible para nuevos tenants']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table platform.tenants [note: 'Cada negocio cliente de Elius (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  plan_id "uuid" [not null, note: 'Plan contratado']
  slug "text" [unique, not null, note: 'Identificador corto único']
  nombre "text" [not null, note: 'Nombre comercial']
  vertical "text" [not null, note: 'veterinaria, restaurante, aerolinea, otro']
  estado "text" [not null, note: 'prueba, activo, suspendido, cancelado']
  fin_prueba "date" [null, note: 'Último día del periodo de prueba']
  razon_social "text" [null, note: 'Nombre legal']
  nit "text" [null, note: 'Identificación tributaria']
  pais "char(2)" [not null, note: 'País ISO 3166']
  zona_horaria "text" [not null, note: 'Ej. America/Bogota']
  moneda "char(3)" [not null, note: 'Moneda de operación']
  eliminado_en "timestamptz" [null, note: 'Borrado lógico']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table platform.usuarios [note: 'Usuarios de la plataforma. Tabla auth.users administrada por Supabase Auth (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  email "text" [unique, not null, note: 'Correo de acceso [PERSONAL]']
  telefono "text" [null, note: 'Teléfono E.164 [PERSONAL]']
  nombre_completo "text" [not null, note: 'Nombre para mostrar [PERSONAL]']
  ultimo_ingreso "timestamptz" [null, note: 'Último inicio de sesión']
}

Table platform.roles [note: 'Los 6 roles generales y fijos (referencia)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  codigo "text" [unique, not null, note: 'super_admin, soporte, administrador, operador, analista, eli']
  nombre "text" [not null, note: 'Nombre visible']
  nivel "text" [not null, note: 'plataforma o tenant']
  descripcion "text" [not null, note: 'Qué hace el rol']
  orden "int" [not null, note: 'Orden de presentación']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table platform.plugins [note: 'Catálogo de plugins (microkernel) (referencia)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  codigo "text" [unique, not null, note: 'vet, restaurant, airline']
  nombre "text" [not null, note: 'Nombre visible']
  esquema "text" [unique, not null, note: 'Esquema de la BD del plugin']
  version "text" [not null, note: 'Versión semántica']
  verticales "text[]" [not null, note: 'Verticales a las que se instala por defecto']
  manifiesto "jsonb" [not null, note: 'Módulos, permisos y configuración que aporta']
  activo "boolean" [not null, note: 'Disponible para instalar']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table platform.permisos [note: 'Módulos y accesos que se pueden otorgar (referencia)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  plugin_id "uuid" [null, note: 'Plugin que lo aporta; vacío = núcleo']
  codigo "text" [unique, not null, note: 'Ej. contactos, vet.historia_clinica']
  modulo "text" [not null, note: 'Módulo funcional']
  descripcion "text" [not null, note: 'Qué permite']
  es_acceso_especial "boolean" [not null, note: 'Se otorga por usuario con un interruptor']
  protege_dato_sensible "boolean" [not null, note: 'Da acceso a datos sensibles']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table platform.rol_permisos [note: 'Qué puede hacer cada rol en cada módulo (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  rol_id "uuid" [not null, note: 'Rol']
  permiso_id "uuid" [not null, note: 'Permiso']
  nivel "text" [not null, note: 'lectura, escritura, total, con_autorizacion']
  origen "text" [not null, note: 'nucleo o código del plugin que lo asignó']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (rol_id, permiso_id) [unique]
  }
}

Table platform.membresias [note: 'Usuario dentro de un tenant con su rol (tenantUser) (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  usuario_id "uuid" [not null, note: 'Usuario']
  rol_id "uuid" [not null, note: 'Rol general dentro del tenant']
  estado "text" [not null, note: 'invitado, activo, inactivo']
  cargo "text" [null, note: 'Etiqueta visible: Veterinario, Mesero… (no da permisos)']
  es_predeterminada "boolean" [not null, note: 'Tenant que se carga en el JWT al iniciar sesión']
  invitado_por "uuid" [null, note: 'Quién lo invitó']
  fecha_ingreso "timestamptz" [not null, note: 'Cuándo aceptó']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (tenant_id, usuario_id) [unique]
  }
}

Table platform.accesos_especiales [note: 'Accesos especiales del plugin otorgados a un usuario (ej. historia clínica) (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']

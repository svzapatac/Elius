Table plugin_airline.aeropuertos [note: 'Aeropuertos con código IATA, comunes a todos los tenants (referencia)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  codigo_iata "char(3)" [unique, not null, note: 'Ej. BOG']
  nombre "text" [not null, note: 'Nombre']
  ciudad "text" [not null, note: 'Ciudad']
  pais "char(2)" [not null, note: 'País ISO 3166']
  zona_horaria "text" [not null, note: 'Zona horaria']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table plugin_airline.aeronaves [note: 'Flota de la aerolínea (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  matricula "text" [not null, note: 'Matrícula']
  modelo "text" [not null, note: 'Ej. A320']
  capacidad "int" [not null, note: 'Sillas totales (RN-A04)']
  mapa_sillas "jsonb" [not null, note: 'Distribución de sillas']
  activa "boolean" [not null, note: 'En servicio']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (tenant_id, matricula) [unique]
  }
}

Table plugin_airline.rutas [note: 'Rutas entre dos aeropuertos (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  origen_id "uuid" [not null, note: 'Aeropuerto de origen']
  destino_id "uuid" [not null, note: 'Aeropuerto de destino (RN-A02)']
  distancia_km "int" [not null, note: 'Distancia']
  duracion_min "int" [not null, note: 'Duración estimada']
  activa "boolean" [not null, note: 'En operación']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (tenant_id, origen_id, destino_id) [unique]
  }
}

Table plugin_airline.vuelos [note: 'Vuelos programados (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  ruta_id "uuid" [not null, note: 'Ruta']
  aeronave_id "uuid" [not null, note: 'Aeronave']
  numero_vuelo "text" [not null, note: 'Ej. EL123']
  salida_programada "timestamptz" [not null, note: 'Salida']
  llegada_programada "timestamptz" [not null, note: 'Llegada (RN-A03)']
  estado "text" [not null, note: 'programado, abordando, salio, llego, retrasado, cancelado']
  puerta "text" [null, note: 'Puerta']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table plugin_airline.tarifas_vuelo [note: 'Precio y cupos de cada tarifa del catálogo en cada vuelo (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  vuelo_id "uuid" [not null, note: 'Vuelo']
  tarifa_id "uuid" [not null, note: 'Tarifa (ítem del catálogo)']
  precio "numeric(14,2)" [not null, note: 'Precio en este vuelo']
  cupos_totales "int" [not null, note: 'Cupos asignados']
  cupos_vendidos "int" [not null, note: 'Cupos vendidos']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (vuelo_id, tarifa_id) [unique]
  }
}

Table plugin_airline.reserva_pasajeros [note: 'Pasajeros de cada reserva aérea (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  reserva_id "uuid" [not null, note: 'Reserva']
  contacto_id "uuid" [not null, note: 'Pasajero']
  tipo_pasajero "text" [not null, note: 'ADT adulto, CHD niño, INF infante (RN-A06)']
  necesidades_especiales "text" [null, note: 'Asistencia o condición de salud [SENSIBLE]']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (reserva_id, contacto_id) [unique]
  }
}

Table plugin_airline.tramos_reserva [note: 'Vuelos que componen una reserva, en orden (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  reserva_id "uuid" [not null, note: 'Reserva']
  tarifa_vuelo_id "uuid" [not null, note: 'Vuelo y tarifa']
  orden_tramo "int" [not null, note: '1 = ida, 2 = regreso…']
  estado "text" [not null, note: 'confirmado, cambiado, cancelado']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table plugin_airline.tiquetes [note: 'Tiquete de un pasajero en un tramo (transicion)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  reserva_pasajero_id "uuid" [not null, note: 'Pasajero']
  tramo_id "uuid" [not null, note: 'Tramo']
  numero_tiquete "text" [unique, not null, note: 'Número de tiquete']
  silla "text" [null, note: 'Silla asignada (RN-A07)']
  estado "text" [not null, note: 'emitido, usado, anulado']
  checkin_en "timestamptz" [null, note: 'Hora de check-in (RN-A08)']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (reserva_pasajero_id, tramo_id) [unique]
  }
}

Table plugin_airline.equipajes [note: 'Equipaje registrado en un tiquete (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  tiquete_id "uuid" [not null, note: 'Tiquete']
  tipo "text" [not null, note: 'mano, bodega, especial']
  peso_kg "numeric(5,2)" [not null, note: 'Peso']
  etiqueta "text" [not null, note: 'Número de etiqueta']
  estado "text" [not null, note: 'registrado, cargado, entregado, perdido']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table elius.tickets [note: 'Tickets de soporte: lo que el Administrador, el Operador o Soporte reportan, con categoría, prioridad y solución (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Negocio dueño del ticket']
  numero "int" [not null, note: 'Consecutivo por negocio']
  codigo "text" [not null, note: 'Código visible, TCK-0001']
  categoria "text" [not null, note: '01 General · 02 Reservas · 03 Pedidos · 04 Pagos · 05 Contabilidad · 06 Usuarios · 07 Integraciones']
  prioridad "text" [not null, note: 'baja, media, alta, critica']
  estado "text" [not null, note: 'abierto, en_proceso, resuelto']
  asunto "text" [not null, note: 'Resumen (mínimo 5 caracteres)']
  descripcion "text" [not null, note: 'Detalle del problema']
  origen "text" [not null, note: 'panel, reporte, soporte, demo']
  creado_por "uuid" [null, note: 'Quién lo creó']
  creado_por_rol "text" [null, note: 'Rol con el que lo creó']
  contacto_id "uuid" [null, note: 'Cliente al que se refiere (opcional)']
  asignado_a "uuid" [null, note: 'Quién de Soporte lo atiende']
  resuelto_por "uuid" [null, note: 'Quién lo resolvió']
  solucion "text" [null, note: 'Qué se hizo (obligatoria al resolver)']
  resuelto_en "timestamptz" [null, note: 'Cuándo se resolvió']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (tenant_id, numero) [unique]
  }
}

Table elius.ticket_notas [note: 'Cronología de un ticket: notas, cambios de estado, solución y datos corregidos (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Negocio dueño']
  ticket_id "uuid" [not null, note: 'Ticket al que pertenece']
  autor_id "uuid" [null, note: 'Quién escribió']
  autor_rol "text" [not null, note: 'Rol de quien escribió']
  tipo "text" [not null, note: 'nota, estado, solucion, dato_corregido, usuario']
  texto "text" [not null, note: 'Contenido']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table elius.manual_soporte [note: 'Manual de Soporte: pasos para resolver cada categoría de ticket (igual para todos los negocios) (referencia)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  categoria "text" [not null, note: '01 a 07, igual que los tickets']
  titulo "text" [not null, note: 'Título del procedimiento']
  pasos "text" [not null, note: 'Pasos a seguir']
  orden "int" [not null, note: 'Orden dentro de la categoría']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
}

Table platform.accesos_bd [note: 'Usuarios de base de datos con login (uno por rol) y la identidad de la aplicación que representan (referencia)'] {
  usuario_bd "text" [pk, not null, note: 'Nombre del usuario de PostgreSQL']
  usuario_id "uuid" [not null, note: 'Usuario de la aplicación que representa']
  descripcion "text" [not null, note: 'Qué rol y negocio representa']
  creado_en "timestamptz" [not null, note: 'Cuándo se creó']
}


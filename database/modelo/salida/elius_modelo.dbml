    (tenant_id, proveedor, ambiente) [unique]
  }
}

Table elius.recaudos [note: 'Cobros creados en la pasarela: llave Bre-B y QR por el monto exacto (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
  orden_id "uuid" [not null, note: 'Orden que se cobra']
  pasarela_id "uuid" [not null, note: 'Pasarela usada']
  codigo_referencia "text" [not null, note: 'reference_code enviado a Factus (único por empresa)']
  monto "numeric(14,2)" [not null, note: 'Monto exacto: Factus no acepta parciales ni montos distintos']
  llave_breb "text" [null, note: 'breb_key que Eli envía al cliente']
  url_qr "text" [null, note: 'Imagen del QR en Supabase Storage']
  expira_en "timestamptz" [null, note: 'qr_expires_at']
  estado "text" [not null, note: 'listo, pagado, vencido, anulado']
  cobrado_en "timestamptz" [null, note: 'collected_at']
  pagador_nombre "text" [null, note: 'payer.name del webhook [PERSONAL]']
  pagador_documento "text" [null, note: 'payer.document_type y document_number [PERSONAL]']
  confirmado_por_api "boolean" [not null, note: 'Se verificó con GET /v1/collections/{reference}']
  renovaciones "int" [not null, note: 'Veces que se renovó la expiración']
  creado_en "timestamptz" [not null, note: 'Fecha de creación']
  actualizado_en "timestamptz" [not null, note: 'Fecha de la última modificación']
  indexes {
    (pasarela_id, codigo_referencia) [unique]
  }
}


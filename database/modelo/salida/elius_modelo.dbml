}

Table elius.pasarelas_pago [note: 'Pasarelas de pago del negocio (Factus Pay con llave Bre-B) y su configuración (entidad)'] {
  id "uuid" [pk, not null, note: 'Identificador único']
  tenant_id "uuid" [not null, note: 'Tenant dueño del registro']
